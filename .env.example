# Base URL of the Velara CRM API, including the /api prefix.
# Required for production builds; defaults to http://localhost:3001/api in dev.
VITE_API_URL="http://localhost:3001/api"

# Set to "true" to show the demo-account shortcuts on the login screen.
# Leave unset for real deployments.
VITE_ENABLE_DEMO_LOGIN="false"
