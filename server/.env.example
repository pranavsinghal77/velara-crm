# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. Use the pooled (pgbouncer) URL in serverless envs.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Postgres schema holding the tables. Default "public". Useful for running a
# second copy of the app against the same database without collisions.
DB_SCHEMA="public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
# REQUIRED and MUST differ from the access secret.
JWT_REFRESH_SECRET=""
# Access token lifetime (short — it lives in memory on the client).
ACCESS_TOKEN_TTL="15m"
# Refresh token lifetime (httpOnly cookie).
REFRESH_TOKEN_TTL_DAYS="30"
# bcrypt work factor. 12 is a sane 2026 default.
BCRYPT_ROUNDS="12"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT="3001"
NODE_ENV="development"
# Comma-separated allowlist of browser origins permitted to call this API.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Set when running behind a reverse proxy / load balancer so client IPs
# (used for rate limiting) are read from X-Forwarded-For.
TRUST_PROXY="false"
# IANA timezone used to render business dates (reminder due dates etc).
APP_TIMEZONE="Asia/Kolkata"

# ─── Credential encryption ───────────────────────────────────────────────────
# 32 bytes, base64. Encrypts credentials the server must be able to read back:
# tenant AI keys, social platform tokens, MCP tokens, webhook signing secrets.
# Required for any of those features; without it they refuse to store secrets
# rather than holding them in plaintext.
#
# Generate with: openssl rand -base64 32
#
# Losing this value makes every stored credential unreadable. Back it up with
# your other secrets, and treat rotating it as a re-connect for every tenant.
ENCRYPTION_KEY=""

# ─── Billing (optional) ──────────────────────────────────────────────────────
# Metering, plan limits and overage calculation all work without these. Stripe
# only turns the locally computed invoices into real charges.
STRIPE_SECRET_KEY=""
# From the Stripe CLI or dashboard, for the webhook endpoint at
# POST /api/billing/stripe-webhook. Deliveries are rejected without it.
STRIPE_WEBHOOK_SECRET=""

# ─── Public origins ──────────────────────────────────────────────────────────
# Used to build OAuth redirect URIs and to send the browser back after a
# round trip. Derived from configuration rather than the incoming request,
# because a redirect_uri taken from the Host header is attacker-influenced and
# has to match what each provider has registered, exactly.
PUBLIC_API_URL="http://localhost:3001"
PUBLIC_APP_URL="http://localhost:5173"

# ─── Social channels (optional) ──────────────────────────────────────────────
# Each platform is independent: one with no credentials reports itself as
# unavailable in Settings, naming the variables below, instead of appearing
# connected.
#
# One Meta app covers Facebook Pages, Instagram and WhatsApp Business.
# Register these redirect URIs on it:
#   <PUBLIC_API_URL>/api/social/callback/facebook
#   <PUBLIC_API_URL>/api/social/callback/instagram
#   <PUBLIC_API_URL>/api/social/callback/whatsapp
# Publishing on behalf of other businesses additionally requires Meta App
# Review for pages_manage_posts and instagram_content_publish, and an
# Instagram account must be Business/Creator linked to a Page.
META_APP_ID=""
META_APP_SECRET=""

# Redirect URI: <PUBLIC_API_URL>/api/social/callback/linkedin
# Posting to a company page also needs the Community Management API product
# enabled on the LinkedIn app; a personal profile works with w_member_social.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Redirect URI: <PUBLIC_API_URL>/api/social/callback/x
# Uses PKCE. Posting requires a paid X API tier; the free tier is read-only
# for most endpoints.
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# The background worker: publishes scheduled posts when their time arrives,
# refreshes provider tokens before they expire, clears spent OAuth state and
# pulls engagement figures. Leave it on — with it off, a scheduled post is
# stored and never published.
#
# Set false on all but one instance if you run several and would rather not
# rely on the per-post claim to keep them from racing each other.
SOCIAL_SCHEDULER="true"
# How often to look for posts that have come due.
SOCIAL_POLL_INTERVAL_MS="60000"
# How often to sweep engagement figures for tenants that posted in the last
# 30 days. The expensive job; every provider counts these against a rate limit.
SOCIAL_INSIGHTS_INTERVAL_MINUTES="360"
# Staleness floor. Figures newer than this are left alone whether the request
# came from the scheduler or from a user pressing Refresh, so a held-down
# button costs nothing after the first press.
SOCIAL_INSIGHTS_MAX_AGE_MINUTES="15"

# ─── AI (optional) ───────────────────────────────────────────────────────────
# Leave blank to run without AI. Endpoints then return 503 instead of
# fabricating plausible-looking results.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_VISION_MODEL="gemini-2.5-flash"
